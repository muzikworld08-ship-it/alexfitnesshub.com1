rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alexfitnesshub@gmail.com' ||
        request.auth.token.email == 'muzikworld08@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    // --- Exercises Collection ---
    match /exercises/{exerciseId} {
      allow read, write: if true;
    }

    // --- Admin Logs ---
    match /admin_logs/{logId} {
      allow read, write: if true;
    }

    match /admin_activities/{logId} {
      allow read, write: if true;
    }

    match /admin_activity_logs/{logId} {
      allow read, write: if true;
    }

    // --- Exercise Media Backup Collection ---
    match /exercise_media/{mediaId} {
      allow read, write: if true;
    }

    // --- Assets Manifest Collection ---
    match /assets_manifest/{assetId} {
      allow read, write: if true;
    }

    // --- Newsletter Subscribers ---
    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    // --- User Workout Actions ---
    match /user_workout_actions/{actionId} {
      allow read, write: if true;
    }

    // --- Progress Logs ---
    match /progress_logs/{logId} {
      allow read, write: if true;
    }

    // --- Transactions ---
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // --- AI Coach Chats ---
    match /ai_coach_chats/{chatId} {
      allow read, write: if true;
    }

    // --- Custom Programs ---
    match /custom_programs/{programId} {
      allow read, write: if true;
    }

    // --- Favorite Videos ---
    match /favorite_videos/{favoriteId} {
      allow read, write: if true;
    }

    // --- Video Search History ---
    match /video_search_history/{historyId} {
      allow read, write: if true;
    }

    // --- Testimonials ---
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }

    // --- Popup Testimonials ---
    match /popup_testimonials/{testimonialId} {
      allow read, write: if true;
    }

    // --- Payments ---
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // --- Weekly Reports ---
    match /weekly_reports/{reportId} {
      allow read, write: if true;
    }

    // --- Vitals Logs ---
    match /vitals_logs/{logId} {
      allow read, write: if true;
    }

    // --- Community Posts ---
    match /community_posts/{postId} {
      allow read, write: if true;
    }

    // --- Generated Exercises ---
    match /generated_exercises/{exerciseId} {
      allow read, write: if true;
    }

    // --- User Inspirations (Poster Art Gallery) ---
    match /user_inspirations/{inspirationId} {
      allow read, write: if true;
    }

    // --- Belly Fat Shred Program ---
    match /belly_fat_shred_progress/{userId} {
      allow read, write: if true;
    }

    // --- Premium 90 Day Challenges ---
    match /user_premium_challenges/{userId} {
      allow read, write: if true;
    }

    // --- Workout Library Filters ---
    match /workout_library_filters/{userId} {
      allow read, write: if true;
    }

    // --- Lifestyle Fitness Academy Progress ---
    match /user_academy_progress/{userId} {
      allow read, write: if true;
    }

    // --- Calibration Goals ---
    match /calibration_goals/{userId} {
      allow read, write: if true;
    }

    // --- Todos Collection ---
    match /todos/{todoId} {
      allow read, write: if true;
    }

    // --- Mail (Firebase Trigger Email Queue) ---
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // Fallback for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
